<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-only manifest overlay. Adds an exported control receiver so the
  power-measurement script (tools/ghost-power-run.sh) can load a route and
  start/stop a ghost ride over adb. Not present in release builds.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <receiver
            android:name="com.crazycapy.randonneur.debug.DebugControlReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.crazycapy.randonneur.debug.START_GHOST" />
                <action android:name="com.crazycapy.randonneur.debug.STOP" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
