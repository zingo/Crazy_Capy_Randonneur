<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-only manifest overlay. Adds an exported control receiver so the
  power-measurement script (tools/ghost-power-run.sh) and the mock-GPS test
  (tools/mock-route.sh) can load a route and start/stop a ride over adb — a
  ghost ride (simulated) or a real-GPS ride driven by an adb mock provider.
  Not present in release builds.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <receiver
            android:name="com.crazycapy.randonneur.debug.DebugControlReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.crazycapy.randonneur.debug.START_GHOST" />
                <action android:name="com.crazycapy.randonneur.debug.START_GPS" />
                <action android:name="com.crazycapy.randonneur.debug.STOP" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
